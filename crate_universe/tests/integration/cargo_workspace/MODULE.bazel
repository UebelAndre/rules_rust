module(
    name = "cu_test_cargo_workspace",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.0.0")
local_path_override(
    module_name = "rules_rust",
    path = "../../../..",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crate_index_cargo_workspace",
    cargo_config = "//:.cargo/config.toml",
    cargo_lockfile = "//:Cargo.Bazel.lock",
    lockfile = "//:cargo-bazel-lock.json",
    manifests = ["//:Cargo.toml"],
)
use_repo(
    crate,
    "crate_index_cargo_workspace",
)

# A `crate.annotation` applies at render time, not at pin time, so its patches
# must reach the crate's repository from the rendered context: `rng` tests the
# function this patch adds.
crate.annotation(
    crate = "rand",
    patch_args = ["-p1"],
    patches = ["//:rand_patched_by_annotation.patch"],
    repositories = ["crate_index_cargo_workspace"],
)
