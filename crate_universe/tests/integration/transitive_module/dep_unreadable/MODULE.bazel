"""A dependency module whose shipped lockfile cannot be read.

Its `cargo-bazel-lock.json` stands in for one written by a rules_rust whose
lockfile schema this version does not understand. A consumer must say so and
resolve the repository from `Cargo.Bazel.lock` instead, which pins `cfg-if` to
`1.0.0` behind a `1` requirement.
"""

module(
    name = "dep_unreadable",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.0.0")
local_path_override(
    module_name = "rules_rust",
    path = "../../../../..",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2021")
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_specs(
    name = "dep_unreadable_crates",
    cargo_lockfile = "//:Cargo.Bazel.lock",
    lockfile = "//:cargo-bazel-lock.json",
)
crate.spec(
    package = "cfg-if",
    repositories = ["dep_unreadable_crates"],
    version = "1",
)
use_repo(crate, "dep_unreadable_crates")
