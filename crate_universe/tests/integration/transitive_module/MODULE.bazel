"""A module consuming crate_universe repositories declared by its dependencies.

`dep_locked` ships a `cargo-bazel-lock.json`, which is used as it is. `dep_unlocked`
ships none: its repositories are resolved by this module, from the `Cargo.lock` it
has for one of them and from the requirements alone for the other. `dep_unreadable`
ships one this version of rules_rust cannot read, which is reported and treated as
none. The resolutions are kept in this module's `MODULE.bazel.lock`.

`dep_specs_only` declares its repository with specs alone and comes from the registry
in `registry/`, whose archive URL does not exist: resolving it must not fetch it.
"""

module(
    name = "cu_test_transitive_module",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.0.0")
local_path_override(
    module_name = "rules_rust",
    path = "../../../..",
)

bazel_dep(name = "dep_locked", version = "0.0.0")
local_path_override(
    module_name = "dep_locked",
    path = "dep_locked",
)

bazel_dep(name = "dep_unlocked", version = "0.0.0")
local_path_override(
    module_name = "dep_unlocked",
    path = "dep_unlocked",
)

bazel_dep(name = "dep_unreadable", version = "0.0.0")
local_path_override(
    module_name = "dep_unreadable",
    path = "dep_unreadable",
)

bazel_dep(name = "dep_specs_only", version = "1.0.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2021")
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_specs(
    name = "root_crates",
    cargo_lockfile = "//:Cargo.Bazel.lock",
    lockfile = "//:cargo-bazel-lock.json",
)
crate.spec(
    package = "lazy_static",
    repositories = ["root_crates"],
    version = "=1.5.0",
)
use_repo(crate, "dep_specs_only_crates", "root_crates")
