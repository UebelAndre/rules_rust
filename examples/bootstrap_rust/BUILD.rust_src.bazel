load(":vendored.bzl", "LIBRARY_VENDORED")

# The source of the release. The standard library is `library/`, and the
# crates it depends on are vendored under `vendor/` with everything else the
# tree depends on, in every version something in the tree pins. The standard
# library's versions come from `library/Cargo.lock`, through the generated
# `vendored.bzl`, so nothing here names one.
_CRATES = [
    "alloc",
    "backtrace",
    "compiler-builtins",
    "core",
    "panic_abort",
    "panic_unwind",
    "portable-simd",
    "proc_macro",
    "rustc-std-workspace-alloc",
    "rustc-std-workspace-core",
    "rustc-std-workspace-std",
    "std",
    "std_detect",
    "stdarch",
    "test",
    "unwind",
]

_VENDORED = [
    "cfg-if",
    "getopts",
    "hashbrown",
    "libc",
    "rustc-demangle",
    "rustc-literal-escaper",
]

filegroup(
    name = "library_rs",
    srcs = glob(
        ["library/{}/**/*.rs".format(crate) for crate in _CRATES] +
        ["vendor/{}/**/*.rs".format(directory) for crate in _VENDORED for directory in LIBRARY_VENDORED[crate]],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "library",
    srcs = glob(
        ["library/{}/**".format(crate) for crate in _CRATES] +
        ["vendor/{}/**".format(directory) for crate in _VENDORED for directory in LIBRARY_VENDORED[crate]],
    ),
    visibility = ["//visibility:public"],
)
