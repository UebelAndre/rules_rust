"""rules_rust - bootstrap_rust example"""

module(
    name = "bootstrap_rust_example",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.0.0")
local_path_override(
    module_name = "rules_rust",
    path = "../..",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# The two inputs this example fetches, from the same Rust release: the host
# toolchain, whose compiler the toolchains in `BUILD.bazel` are assembled
# around, and the source of the standard library it compiles for them.
# Everything else on those toolchains is built here.
RUST_VERSION = "1.99.1"

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = [RUST_VERSION],
)
use_repo(rust, "rust_toolchains")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "rust_src",
    build_file = "//:BUILD.rust_src.bazel",
    sha256 = "e485a88c45db546b73571df7bebfcb4454ba4fb552c492e25fc5b00eeb5bf22d",
    strip_prefix = "rust-src-{}/rust-src/lib/rustlib/src/rust".format(RUST_VERSION),
    urls = ["https://static.rust-lang.org/dist/rust-src-{}.tar.xz".format(RUST_VERSION)],
)

register_toolchains(
    # The toolchains whose standard libraries are built from `@rust_src`. Each
    # is picked for its platform alone.
    "//:std_toolchain",
    "//:no_std_toolchain",
    # The host toolchains, which build everything that runs here, the process
    # wrapper and the build scripts included.
    "@rust_toolchains//:all",
)

# A test built for one of the example's platforms runs on an execution
# platform with that platform's constraints, so the platforms are ones. The
# host comes first so that everything else keeps running, and being built,
# on it.
register_execution_platforms(
    "@platforms//host",
    "//:with_std",
    "//:without_std",
)
