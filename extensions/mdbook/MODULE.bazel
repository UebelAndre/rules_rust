"""bazelbuild/rules_rust/extensions/mdbook"""

module(
    name = "rules_rust_mdbook",
    version = "0.74.0",
)

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_cc", version = "0.2.4")
bazel_dep(name = "bazel_features", version = "1.32.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.1.0")

rust_ext = use_extension("//:extensions.bzl", "rust_ext")
use_repo(
    rust_ext,
    "rules_rust_mdbook_toolchain",
)

# Use a short name to avoid MAX_PATH issues on windows.
# `rmdbi` == `rules_mdbook_crate_index`
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "mdbook",
    gen_binaries = ["mdbook"],
)
crate.from_cargo(
    name = "rmdbi",
    cargo_lockfile = "//private/3rdparty:Cargo.lock",
    lockfile = "//private/3rdparty:cargo-bazel-lock.json",
    manifests = ["//private/3rdparty:Cargo.toml"],
)
use_repo(crate, "rmdbi")

register_toolchains("@rules_rust_mdbook_toolchain//:toolchain")

bazel_dep(name = "bazel_ci_rules", version = "1.0.0", dev_dependency = True)

rust_ext_dev = use_extension(
    "//private:internal_extensions.bzl",
    "rust_ext_dev",
    dev_dependency = True,
)
use_repo(
    rust_ext_dev,
    "buildkite_config",
)
