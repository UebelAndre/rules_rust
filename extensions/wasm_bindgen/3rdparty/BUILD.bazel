# The crates of `@rrwbd` are declared in `Cargo.toml`; the lockfiles record
# their resolution.
exports_files([
    "BUILD.wasm-bindgen-cli.bazel",
    "Cargo.lock",
    "Cargo.toml",
    "cargo-bazel-lock.json",
])

alias(
    name = "wasm_bindgen_cli",
    actual = "@rrwbd//wasm-bindgen-cli__wasm-bindgen",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

alias(
    name = "wasm_bindgen_test_runner",
    actual = "@rrwbd//wasm-bindgen-cli__wasm-bindgen-test-runner",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

alias(
    name = "wasm_bindgen",
    actual = "@rrwbd//wasm-bindgen",
    visibility = ["//visibility:public"],
)

alias(
    name = "wasm_bindgen_test",
    actual = "@rrwbd//wasm-bindgen-test",
    visibility = ["//visibility:public"],
)
