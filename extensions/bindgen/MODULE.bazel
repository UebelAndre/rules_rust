"""bazelbuild/rules_rust/extensions/bindgen"""

module(
    name = "rules_rust_bindgen",
    version = "0.75.0",
)

bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "bazel_features", version = "1.32.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.9")
bazel_dep(name = "llvm-project", version = "17.0.3.bcr.4")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "bindgen",
    gen_build_script = "on",
)
crate.annotation(
    crate = "bindgen-cli",
    gen_binaries = ["bindgen"],
)
crate.annotation(
    crate = "clang-sys",
    gen_build_script = "on",
)
crate.annotation(
    crate = "libc",
    gen_build_script = "on",
)
crate.from_cargo(
    name = "rules_rust_bindgen_deps",
    cargo_lockfile = "//3rdparty:Cargo.lock",
    generate_build_scripts = False,
    lockfile = "//3rdparty:cargo-bazel-lock.json",
    manifests = ["//3rdparty:Cargo.toml"],
)
use_repo(crate, "rules_rust_bindgen_deps")

register_toolchains(
    "//:default_bindgen_toolchain",
    dev_dependency = True,
)

bazel_dep(name = "rules_testing", version = "0.7.0", dev_dependency = True)
bazel_dep(name = "bazel_ci_rules", version = "1.0.0", dev_dependency = True)

rust_ext_dev = use_extension(
    "//private:internal_extensions.bzl",
    "rust_ext_dev",
    dev_dependency = True,
)
use_repo(
    rust_ext_dev,
    "buildkite_config",
)
