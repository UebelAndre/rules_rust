load("//cargo:defs.bzl", "cargo_build_script")
load("//rust:defs.bzl", "rust_test")

# `cargo_build_script` hands build scripts the Cargo of the registered
# `cargo_toolchain` as `$CARGO`, not the one of the `rust_toolchain`.
cargo_build_script(
    name = "cargo_toolchain_build_rs",
    srcs = ["build.rs"],
    edition = "2021",
)

rust_test(
    name = "cargo_toolchain_test",
    srcs = ["test.rs"],
    edition = "2021",
    deps = [":cargo_toolchain_build_rs"],
)
