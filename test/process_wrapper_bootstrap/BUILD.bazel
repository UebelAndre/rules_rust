load("//rust:defs.bzl", "rust_binary", "rust_test")
load(":process_wrapper_bootstrap_test.bzl", "process_wrapper_bootstrap_test_suite")

# A binary built the ordinary way, through the `rust_toolchain` and the process
# wrapper, next to the process wrapper itself which is built through a
# `rust_bootstrap_toolchain` and the shell script.
rust_binary(
    name = "with_process_wrapper",
    srcs = ["main.rs"],
    edition = "2021",
)

rust_test(
    name = "bootstrap_process_wrapper_test",
    srcs = ["bootstrap_process_wrapper_test.rs"],
    data = [
        "//util/process_wrapper/private:process_wrapper.bat",
        "//util/process_wrapper/private:process_wrapper.sh",
    ],
    edition = "2021",
    deps = ["//rust/runfiles"],
)

process_wrapper_bootstrap_test_suite(name = "process_wrapper_bootstrap_test_suite")
